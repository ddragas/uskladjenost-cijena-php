{
    "name": "infomedia/uskladjenost-cijena-php",
    "description": "PHP SDK for the Usklađenost cijena API (uskladjenost-cijena.com): anchor prices and public price lists under NN 101/2026.",
    "type": "library",
    "license": "MIT",
    "keywords": ["uskladjenost-cijena", "sidrena-cijena", "cjenik", "nn-101-2026", "price-compliance", "croatia"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": { "psr-4": { "UskladjenostCijena\\": "src/" } },
    "autoload-dev": { "psr-4": { "UskladjenostCijena\\Tests\\": "tests/" } },
    "scripts": { "test": "phpunit" },
    "minimum-stability": "stable"
}
